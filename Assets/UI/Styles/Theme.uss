/*
 * Theme.uss — design tokens for DRIFTLINE (space multiplayer shooter).
 * Every other stylesheet reads colors and sizes from these variables,
 * so re-skinning the game means editing this file only.
 * See Docs/UI_DESIGN.md for usage rules.
 */

:root {
    /* Surfaces: deep-space navy, cold so the amber accent reads as "cockpit instrument" */
    --color-bg: #060A13;
    --color-scrim: rgba(4, 7, 14, 0.74);
    --color-glass: rgba(10, 18, 32, 0.62);
    --color-surface: #0D1422;
    --color-surface-raised: #152036;
    --color-surface-sunken: #04070D;
    --color-border: #22314D;
    --color-border-strong: #36507A;

    /* Text */
    --color-text: #E6EDF7;
    --color-text-muted: #8C9BB5;
    --color-text-disabled: #4B5A74;
    --color-text-on-accent: #1A1103;

    /* Accent: signal amber (focus, primary actions, local player, ready abilities) */
    --color-accent: #FFB547;
    --color-accent-hover: #FFCB7A;
    --color-accent-pressed: #D18E2A;
    --color-accent-soft: rgba(255, 181, 71, 0.14);

    /* Teams — never reuse for anything else */
    --color-team-blue: #4DA3FF;
    --color-team-blue-soft: rgba(77, 163, 255, 0.16);
    --color-team-red: #FF5A5F;
    --color-team-red-soft: rgba(255, 90, 95, 0.16);

    /* Ship status */
    --color-shield: #5CD6F0;
    --color-shield-back: #0F2E3A;
    --color-hull: #E6EDF7;
    --color-hull-back: #26303F;
    --color-energy: #9BE36A;
    --color-energy-back: #1E3319;

    /* Feedback + connection quality */
    --color-success: #5FD68A;
    --color-warning: #FFB547;
    --color-danger: #FF6B5A;
    --color-ping-good: #5FD68A;
    --color-ping-ok: #FFB547;
    --color-ping-bad: #FF6B5A;

    /* Chat channels */
    --color-chat-all: #E6EDF7;
    --color-chat-team: #4DA3FF;
    --color-chat-squad: #9BE36A;
    --color-chat-system: #8C9BB5;

    /* Spacing scale (4px base) */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;

    /* Type scale (reference resolution 1920x1080) */
    --font-size-micro: 12px;
    --font-size-caption: 14px;
    --font-size-label: 16px;
    --font-size-body: 18px;
    --font-size-h3: 22px;
    --font-size-h2: 30px;
    --font-size-h1: 44px;
    --font-size-display: 96px;
    --font-size-readout: 40px;

    /* Shape: small radii, one clipped corner look via borders */
    --radius-sm: 2px;
    --radius-md: 4px;
    --radius-lg: 8px;
    --border-width: 1px;

    /* Components */
    --button-height: 52px;
    --ability-size: 60px;
    --avatar-size: 40px;
}
